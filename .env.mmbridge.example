# --- Slack -------------------------------------------------------------------
# Bot token from "OAuth & Permissions" after the app is installed. With token
# rotation (below) it is only needed once, for the first start, and can then be
# removed.
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token from "Basic Information -> App-Level Tokens", scope connections:write.
# This is what Socket Mode connects with; it is not the bot token.
SLACK_APP_TOKEN=xapp-your-app-token

# --- Slack token rotation (optional) -----------------------------------------
# On when both client credentials are set. Switch rotation on in the app first:
# OAuth & Permissions -> token rotation. Slack wants a redirect URL on file
# before it allows that; any https URL on your own domain will do -- nothing has
# to answer there, the bridge never runs the browser sign-in flow.
# Rotation cannot be switched off again once on.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Encrypts the stored token at rest. Generate with: python -m mmbridge genkey
# MMBRIDGE_TOKEN_KEY=
# Only for an app installed AFTER rotation was switched on: its refresh token.
# Otherwise the long-lived SLACK_BOT_TOKEN is exchanged on first start.
# SLACK_REFRESH_TOKEN=
# Refresh this many seconds before expiry (default 3600). 43080 refreshes about
# every two minutes, which is useful for testing and pointless otherwise.
# MMBRIDGE_TOKEN_REFRESH_MARGIN=3600
#
# Any secret in this file can instead be given as NAME_FILE=/path/to/file,
# which is how Docker and Swarm secrets are mounted.

# --- Mattermost --------------------------------------------------------------
MATTERMOST_URL=https://mattermost.example.org
# Personal access token of an ORDINARY USER account -- not a Bot Account.
# A Bot Account cannot post under the original author's name: Mattermost stamps
# from_bot on its posts and then ignores override_username, so every message
# would arrive as the bot. See SETUP.md.
MATTERMOST_TOKEN=your-mattermost-access-token

# --- What to bridge ----------------------------------------------------------
# Explicit allowlist: SLACK_CHANNEL_ID:MATTERMOST_CHANNEL_ID[:label], comma separated.
# Run `mmbridge channels` to list the IDs of both sides.
# Nothing outside this list is ever read or written.
MMBRIDGE_PAIRS=C0123456789:bx8ck7nd9jd4xqz1r3w5abcdef:partner-project

# both | slack_to_mm | mm_to_slack
MMBRIDGE_DIRECTION=both

MMBRIDGE_SYNC_FILES=true
MMBRIDGE_SYNC_EDITS=true
MMBRIDGE_SYNC_DELETES=true
MMBRIDGE_SYNC_REACTIONS=true

# --- Identity ----------------------------------------------------------------
# Show each author's own name and avatar on the far side. Needs
# chat:write.customize in Slack, and EnablePostUsernameOverride /
# EnablePostIconOverride in Mattermost. Set false to prefix the name into the
# message text instead.
MMBRIDGE_IDENTITY_OVERRIDE=true

# Provenance markers. Emptying these hides that a message came through the
# bridge, which is rarely what you want between two organisations.
MMBRIDGE_PROVENANCE_SLACK=via Slack
MMBRIDGE_PROVENANCE_MATTERMOST=via Mattermost

# Icon shown in Slack beside messages from Mattermost authors -- their own
# avatars cannot be used, since Mattermost only serves them to logged-in clients.
# Any publicly reachable square image; an organisation logo works well. Empty
# means Slack shows the app's own icon.
MMBRIDGE_SLACK_ICON_URL=
# Icon shown in Mattermost beside messages from Slack authors who have no picture
# of their own. Anyone who uploaded one to Slack, or has a Gravatar, keeps theirs.
# Empty means Slack's generated default. Must be https and reachable from your
# Mattermost users' browsers.
MMBRIDGE_MATTERMOST_ICON_URL=

# --- Operational -------------------------------------------------------------
# Holds the message-ID mapping that drives threading, edits, deletes and loop
# prevention, so it must survive restarts.
# This default is for running the bridge directly on a host. Leave it commented
# out under Docker: the image already sets MMBRIDGE_DB=/data/mmbridge.sqlite3,
# which is the mounted volume. Setting it here to /data would break local runs.
MMBRIDGE_DB=mmbridge.sqlite3
# How a Mattermost file appears in Slack. Slack will not give you both the
# author's name in the header and the file inside the same message: attaching a
# file to a message strips the username override.
#   thread - author's name on the message, file threaded beneath it (2 messages)
#   inline - one message carrying the file, author named in the text
MMBRIDGE_SLACK_FILE_STYLE=thread

# Show replies from Mattermost in the Slack channel as well as in their thread
# (Slack's "Also send to #channel"), since Slack always collapses threads behind
# "1 reply". Each such reply then appears twice in Slack. Default true.
MMBRIDGE_SLACK_BROADCAST_REPLIES=true

# Leave any Slack channel the app is invited to that is not in MMBRIDGE_PAIRS.
# Nothing from such a channel is forwarded either way; leaving also stops Slack
# delivering its messages to the bridge at all. Needs channels:manage and
# groups:write -- without them the app announces itself but cannot leave.
MMBRIDGE_SLACK_LEAVE_UNAUTHORISED=true
# Posted once before leaving. Leave empty to leave silently. Defaults to a short
# German/English notice.
# MMBRIDGE_SLACK_LEAVE_NOTICE=

MMBRIDGE_MAX_FILE_MB=50
MMBRIDGE_LOG_LEVEL=INFO
